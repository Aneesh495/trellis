{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@trellis/core": ["./packages/core/src/index.ts"],
      "@trellis/parser": ["./packages/parser/src/index.ts"],
      "@trellis/runtime": ["./packages/runtime/src/index.ts"],
      "@trellis/functions": ["./packages/functions/src/index.ts"],
      "@trellis/graph": ["./packages/graph/src/index.ts"],
      "@trellis/spill": ["./packages/spill/src/index.ts"],
      "@trellis/columnar": ["./packages/columnar/src/index.ts"],
      "@trellis/relational": ["./packages/relational/src/index.ts"],
      "@trellis/storage": ["./packages/storage/src/index.ts"],
      "@trellis/crdt": ["./packages/crdt/src/index.ts"],
      "@trellis/server": ["./packages/server/src/index.ts"],
      "@trellis/client": ["./packages/client/src/index.ts"],
      "@trellis/cli": ["./packages/cli/src/index.ts"],
      "@trellis/engine": ["./packages/engine/src/index.ts"]
    }
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/parser/src/**/*.ts",
    "packages/runtime/src/**/*.ts",
    "packages/functions/src/**/*.ts",
    "packages/graph/src/**/*.ts",
    "packages/spill/src/**/*.ts",
    "packages/columnar/src/**/*.ts",
    "packages/relational/src/**/*.ts",
    "packages/storage/src/**/*.ts",
    "packages/crdt/src/**/*.ts",
    "packages/engine/src/**/*.ts",
    "packages/server/src/**/*.ts",
    "tests/framework.ts",
    "tests/runner.ts",
    "tests/core.test.ts",
    "tests/parser.test.ts",
    "tests/runtime.test.ts",
    "tests/functions.test.ts",
    "tests/graph.test.ts",
    "tests/spill.test.ts",
    "tests/columnar.test.ts",
    "tests/relational.test.ts",
    "tests/storage.test.ts",
    "tests/crdt.test.ts",
    "tests/engine.test.ts",
    "tests/server.test.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "c",
    "python"
  ]
}
